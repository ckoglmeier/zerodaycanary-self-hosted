{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "bundle_sha256", "evidence_id", "monitoring_state", "billing_mode"],
  "properties": {
    "schema_version": {"const": "canary-receipt/1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "monitoring_state": {"enum": ["pending", "active", "integration_fixture_only"]},
    "billing_mode": {"const": "developer_inventory_free"}
  }
}
