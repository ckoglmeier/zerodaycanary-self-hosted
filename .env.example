# Copy to .env.local; supply your own credentials. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=                 # pooler connection string (transaction mode)
SUPABASE_SERVICE_ROLE_KEY=       # test scripts only; the app does not use it
STRIPE_SECRET_KEY=               # sk_test_ only until live billing is authorized
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_CENTS=2900  # used only by scripts/stripe-setup.mjs (placeholder)
ANTHROPIC_API_KEY=
OPERATOR_EMAILS=                 # comma-separated operator sign-in emails
CRON_SECRET=
# Optional
# Public-site PostHog. Disabled until a project exists; never use a personal API key.
# Set all three in the intended Vercel environment and rebuild to enable.
# NEXT_PUBLIC_POSTHOG_ENABLED=true
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_public_project_token
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # or https://eu.i.posthog.com
# OBSERVATION_FRESHNESS_HOURS=24
# ANALYZE_PER_HOUR=30
# NEW_SCANS_PER_HOUR=10
# DEVELOPER_PROJECT_LIMIT=25
# MODEL_RATE_TABLE={"name":"...","as_of":"YYYY-MM-DD","source":"...","models":{"claude-opus-5-5":{"input":4,"output":20,"cache_read":0.2}}}

# Optional: isolated development/preview SQL schema; leave unset in production.
# SUPABASE_DB_SCHEMA=zdc_flow_example
# Optional contextual invitations. Without these, requests are saved and the buyer
# shares a recipient-bound link. Sign-in separately uses Supabase SMTP.
# CANARY_INVITATION_MODE=hold  # prevent mail in previews/tests
# Contextual invitation transport (no report body or private question sent):
# RESEND_API_KEY=
# CANARY_EMAIL_FROM=Zero Day Canary <hello@your-verified-domain.example>
# Supabase Auth: configure Resend SMTP in Supabase, not in browser environment.
# smtp.resend.com:465 · user resend · password = Resend API key
# Branded auth templates: supabase/email-templates/provider-patch.json
# Supabase Send Email Hook (adds Reply-To and plain text to auth email):
# SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_...  # same value as the Supabase hook secret
# CANARY_REPLY_TO=hello@your-verified-domain.example

# Team portal: period-end cancellation, subscription quantity edits disabled
# STRIPE_WORKSPACE_PORTAL_CONFIGURATION=

# Private read-only monitoring. Distinct from CRON_SECRET (no job-trigger access).
# MONITOR_TOKEN= # random secret, at least 32 characters
# MONITOR_STARTED_AT= # activation ISO time; keep stable across releases

# Invitations are held until you deliberately configure your sender.
CANARY_INVITATION_MODE=hold
